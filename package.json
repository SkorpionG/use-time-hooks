{
  "name": "use-time-hooks",
  "version": "1.1.0",
  "description": "A comprehensive collection of React hooks for time-based operations including intervals, timeouts, debouncing, throttling, stopwatches, retries, and more",
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "timer",
    "interval",
    "timeout",
    "debounce",
    "throttle",
    "stopwatch",
    "retry",
    "typescript",
    "time",
    "delay",
    "batched-updates",
    "sequential-execution"
  ],
  "license": "MIT",
  "author": "SkorpionG",
  "homepage": "https://github.com/SkorpionG/use-time-hooks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkorpionG/use-time-hooks.git"
  },
  "bugs": {
    "url": "https://github.com/SkorpionG/use-time-hooks/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:all": "npm run format && npm run format --prefix demos",
    "lint:fix:all": "npm run lint:fix && npm run lint:fix --prefix demos",
    "typecheck:all": "npm run typecheck && npm run typecheck --prefix demos",
    "validate": "npm run typecheck && npm run lint && npm run test:run",
    "prepublishOnly": "npm run build && npm run validate",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "precommit": "npm run typecheck && npm run lint-staged"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "20.10.6",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.22.1",
    "npm": ">=7.0.0"
  }
}
