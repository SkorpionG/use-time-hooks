{
  "*.{js,jsx,ts,tsx,mjs,cjs,css,md,json,yml,yaml}": "prettier --write",
  "{src,tests,examples}/**/*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix --max-warnings 0 --no-warn-ignored",
  "demos/src/**/*.{js,jsx,ts,tsx,mjs,cjs}": "npm --prefix demos exec -- eslint --fix --max-warnings 0 --no-warn-ignored"
}
